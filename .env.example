# Copie para .env para mudar os valores padrão do ambiente local (docker compose).
# Os padrões abaixo são só para desenvolvimento.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
UMAMI_DB_PASSWORD=umami
NOTIFY_DB_PASSWORD=notify
NOTIFY_INGEST_DB_PASSWORD=notify_ingest
NOTIFY_COLLECTOR_DB_PASSWORD=notify_collector
# Porta do Umami no host, usada só pelo override de desenvolvimento
# infra/compose/umami-port.yaml (o Umami não publica porta por padrão, #62).
# Para incluí-lo sempre na sua máquina: COMPOSE_FILE=compose.yaml:infra/compose/umami-port.yaml
# (nunca num .env de produção).
UMAMI_PORT=3001
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
UMAMI_APP_SECRET=dev-only-umami-app-secret
PORTAL_PORT=3000
PORTAL_AUTH_SECRET=dev-only-portal-auth-secret-change-me
# Chave de API da conta de serviço do portal no Umami. Gere com:
#   UMAMI_ADMIN_PASSWORD=umami pnpm --filter @notify/portal umami:service-account
UMAMI_API_KEY=
INGEST_WEB_PORT=3002
# Header em que o gateway entrega ao Umami o IP já truncado.
CLIENT_IP_HEADER=x-notify-client-ip
# CIDRs separados por vírgula de onde o X-Forwarded-For é aceito (vazio: nenhum).
INGEST_TRUSTED_PROXIES=
# Eventos por segundo e rajada por IP truncado.
INGEST_RATE_LIMIT=20
INGEST_RATE_BURST=40
INGEST_SITE_CACHE_TTL=5s
# Prova de execução de JS (#25): chave dos desafios (32+ caracteres) e dificuldade em bits.
INGEST_PROOF_SECRET=dev-only-ingest-proof-secret-change-me
INGEST_PROOF_BITS=12
# Limite de fingerprints distintas por IP truncado e site na janela (#26); 0 desliga.
INGEST_FINGERPRINT_LIMIT=50
INGEST_FINGERPRINT_WINDOW=10m
