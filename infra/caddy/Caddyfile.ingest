# Caddy das VMs de INGESTÃO extras (#52, ADR 0009): só o host da ingestão e só
# as rotas públicas do gateway (/e, /c, /s/* e /healthz). Nunca o portal nem o
# Umami; o resto responde 404. O mesmo bloco do Caddyfile principal, sem o
# host do portal.
#
# Certificado: cada VM pede o seu por HTTP-01. Atrás de um balanceador que
# repassa 80/443 sem terminar o TLS, o desafio cai numa VM qualquer e pode
# falhar; resolver isso (certificado no balanceador ou outro método) está em
# aberto no ADR 0009. Com IP flutuante (uma VM ativa por vez) funciona.
#
# O nome do host da ingestão não pode ter termos que ad blockers bloqueiam
# (`umami`, `analytics`, `track`, `collect`; ver CLAUDE.md).

{
	email {$ACME_EMAIL}
	# Nenhum log guarda o IP do cliente, os cabeçalhos ou a URL com query: nem
	# os de erro (por exemplo, 502 quando o gateway reinicia), que o Caddy
	# grava mesmo sem access log. O IP completo nunca é persistido (CLAUDE.md).
	log default {
		output stderr
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>uri delete
			request>tls delete
		}
	}
	# Sem trusted_proxies: o Caddy descarta o X-Forwarded-For que chega e manda
	# o IP real da conexão. O gateway só confia no X-Forwarded-For do Caddy
	# (TRUSTED_PROXIES em compose/prod.yaml). Para o IP real chegar ao Caddy, o
	# Docker da VM roda com userland-proxy desligado (Ansible, papel docker).
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Sem o cabeçalho "Server: Caddy".
		-Server
	}
}

{$INGEST_HOST} {
	import security_headers
	@gateway path /e /c /s/* /healthz
	handle @gateway {
		encode zstd gzip
		reverse_proxy ingest-web:8080
	}
	handle {
		respond 404
	}
}
