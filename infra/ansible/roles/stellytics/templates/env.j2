# Gerado pelo Ansible (infra/ansible/roles/stellytics). Não edite na VM.
POSTGRES_PASSWORD={{ postgres_password }}
UMAMI_DB_PASSWORD={{ umami_db_password }}
STELLYTICS_DB_PASSWORD={{ stellytics_db_password }}
STELLYTICS_INGEST_DB_PASSWORD={{ stellytics_ingest_db_password }}
STELLYTICS_COLLECTOR_DB_PASSWORD={{ stellytics_collector_db_password }}
UMAMI_APP_SECRET={{ umami_app_secret }}
PORTAL_AUTH_SECRET={{ portal_auth_secret }}
INGEST_PROOF_SECRET={{ ingest_proof_secret }}
UMAMI_API_KEY={{ umami_api_key | default('') }}
SMTP_URL={{ smtp_url }}
MAIL_FROM={{ mail_from }}
SIGNUP_APPROVAL={{ signup_approval | default(false) | bool | lower }}
PORTAL_HOST={{ portal_host }}
INGEST_HOST={{ ingest_host }}
API_HOST={{ api_host }}
ACME_EMAIL={{ acme_email }}
PORTAL_IMAGE={{ portal_image }}
INGEST_WEB_IMAGE={{ ingest_web_image }}
COLLECTOR_IMAGE={{ collector_image }}
ROLLUP_IMAGE={{ rollup_image }}
# Retenção dos eventos web no Umami (#154): dias, cerca de seis meses.
UMAMI_RETENTION_DAYS={{ umami_retention_days | default(183) }}
COLLECTOR_MEM_LIMIT={{ collector_mem_limit | default('512m') }}
INGEST_SITE_STALE_TTL={{ ingest_site_stale_ttl | default('0') }}
INGEST_RELAY_MAX_INFLIGHT={{ ingest_relay_max_inflight | default('0') }}
INGEST_RELAY_QUEUE_WAIT={{ ingest_relay_queue_wait | default('250ms') }}
STELLYTICS_DATA_DIR={{ stellytics_data_dir }}
WALG_S3_PREFIX={{ walg_s3_prefix }}
WALG_S3_ENDPOINT={{ walg_s3_endpoint }}
WALG_S3_REGION={{ walg_s3_region }}
WALG_S3_ACCESS_KEY={{ walg_s3_access_key }}
WALG_S3_SECRET_KEY={{ walg_s3_secret_key }}
WALG_LIBSODIUM_KEY={{ walg_libsodium_key }}
WALG_RETAIN_FULL={{ walg_retain_full }}
{% if ha_replication | default(false) | bool %}
# Alta disponibilidade (#52): replicação do Postgres e rede privada.
REPLICATION_DB_PASSWORD={{ replicator_db_password }}
{% if monitor_replication_enabled | default(false) | bool %}
REPLICATION_MONITOR_PASSWORD={{ replication_monitor_password }}
REPLICATION_MONITOR_CIDR={{ monitor_replication_cidr }}
{% endif %}
REPLICATION_ALLOWED_CIDR={{ ha_replication_cidr }}
REPLICATION_MAX_SLOT_WAL_KEEP={{ ha_replication_max_slot_wal_keep }}
HA_PRIVATE_IP={{ ha_private_ip }}
{% endif %}
