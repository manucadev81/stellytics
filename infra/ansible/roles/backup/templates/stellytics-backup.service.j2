# Backup base do Postgres no Object Storage (infra/compose/postgres/backup.sh).
[Unit]
Description=stellytics: backup base do Postgres (WAL-G)
After=docker.service
Requires=docker.service
# Nunca faz backup de um banco que não está no volume de dados.
RequiresMountsFor={{ stellytics_data_dir }}

[Service]
Type=oneshot
WorkingDirectory={{ stellytics_root }}/infra/compose
ExecStart=/usr/bin/docker compose -f prod.yaml exec -T -u postgres postgres stellytics-backup
