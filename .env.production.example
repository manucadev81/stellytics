# init.sh gera valores aleatórios para todos os campos de senha/segredo vazios.
# Preencha domínios, e-mail e SMTP antes de executar deploy.sh.
POSTGRES_PASSWORD=
UMAMI_DB_PASSWORD=
STELLYTICS_DB_PASSWORD=
STELLYTICS_INGEST_DB_PASSWORD=
STELLYTICS_COLLECTOR_DB_PASSWORD=
UMAMI_APP_SECRET=
PORTAL_AUTH_SECRET=
INGEST_PROOF_SECRET=

# Domínios com registros DNS A/AAAA apontando para a VPS.
PORTAL_HOST=
PORTAL_ALIAS_HOST=
INGEST_HOST=
API_HOST=
ACME_EMAIL=
POSTGRES_ADMIN_PORT=5432

# SMTP real para confirmação de cadastro e redefinição de senha.
SMTP_URL=
MAIL_FROM=

# Vazia no primeiro deploy. Configure a chave da conta de serviço do Umami depois.
UMAMI_API_KEY=
SIGNUP_APPROVAL=false
INGEST_RATE_LIMIT=20
INGEST_RATE_BURST=40
INGEST_FINGERPRINT_LIMIT=50
INGEST_SITE_STALE_TTL=0
INGEST_RELAY_MAX_INFLIGHT=0
INGEST_RELAY_QUEUE_WAIT=250ms
COLLECTOR_KEY_CACHE_TTL=60s
COLLECTOR_MEM_LIMIT=512m
ROLLUP_INTERVAL=15m
ROLLUP_LOOKBACK=48h
UMAMI_RETENTION_DAYS=183
